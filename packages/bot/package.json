{
  "name": "@fyendal/bot",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./evaluation": "./src/evaluation.ts",
    "./intents": "./src/intents.ts",
    "./client-task": "./src/client-task.ts",
    "./runtime-id": "./src/generated-runtime-id.ts"
  },
  "scripts": {
    "build": "pnpm -w generate:bot-runtime && tsc -p tsconfig.json",
    "evaluate": "vitest run src/evaluation.test.ts --reporter=verbose",
    "typecheck": "pnpm -w generate:bot-runtime && tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w generate:bot-runtime && vitest run src --maxWorkers=2"
  },
  "dependencies": {
    "@fyendal/cards": "workspace:*",
    "@fyendal/engine": "workspace:*",
    "@fyendal/shared": "workspace:*",
    "@noble/hashes": "2.0.1",
    "@fyendal/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
