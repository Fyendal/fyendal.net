# Copy to .env and edit. .env is gitignored and loaded by docker compose.
# Local/self-host stack only. Production deployment configuration is managed
# separately; production credentials stay outside this repository.

# Public hostname Caddy serves (automatic HTTPS). Use :80 for local testing.
DOMAIN=fyendal.example.com

# Postgres credentials — db, app and backup services share these.
POSTGRES_USER=fyendal
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=fyendal

# Public origin of the client; browser websocket upgrades must match it.
APP_ORIGIN=https://fyendal.example.com
# The app container is reached through exactly one trusted Caddy proxy.
TRUSTED_PROXY_HOPS=1
AUTH_KDF_CONCURRENCY=1
# Outgoing WebSocket compression starts at 1 KiB. Set false and restart to disable.
WS_COMPRESSION=true

# Optional unless direct Fabrary URL imports are enabled.
FABRARY_API_SECRET=

# Keep stable across compatible server updates. Change only when active room
# state must be invalidated because the new rules/state/wire contract is incompatible.
# rules-16 fixes Crown of Dominion granting Royal to its controller's hero,
# including Tome of Imperial Flame drawing two cards while Crown is equipped.
# rules-17 also implements Blessing of Themis's naming and banished-card triggers.
# rules-18 extends pending-play wire metadata to arena ability sources.
# rules-19 fixes Soulbond Resolve's conditional first-damage prevention.
# rules-20 limits Warmonger's Diplomacy restrictions to each hero's next turn.
# Activate explicitly and deploy matching server/client builds.
RULESET_VERSION=rules-20

# Optional: also upload daily backups to this GCS bucket.
# Requires a custom backup image with gsutil and workload credentials.
# GCS_BUCKET=fyendal-backups
