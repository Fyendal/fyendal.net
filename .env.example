# Copy to .env and edit. .env is gitignored and loaded by docker compose.
# Local/self-host stack only. Production Cloud Run and Cloud SQL configuration
# is managed separately; production credentials stay in Secret Manager.

# Public hostname Caddy serves (automatic HTTPS). Use :80 for local testing.
DOMAIN=fyendal.example.com

# Postgres credentials — db, app and backup services share these.
POSTGRES_USER=fyendal
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=fyendal

# Public origin of the client; browser websocket upgrades must match it.
APP_ORIGIN=https://fyendal.example.com
# The app container is reached through exactly one trusted Caddy proxy.
TRUSTED_PROXY_HOPS=1
AUTH_KDF_CONCURRENCY=1

# Optional unless direct Fabrary URL imports are enabled.
FABRARY_API_SECRET=

# Keep stable across compatible server updates. Change only when active room
# state must be invalidated because the new rules/state contract is incompatible.
RULESET_VERSION=rules-1

# Optional: also upload daily backups to this GCS bucket.
# Requires a custom backup image with gsutil and workload credentials.
# GCS_BUCKET=fyendal-backups
